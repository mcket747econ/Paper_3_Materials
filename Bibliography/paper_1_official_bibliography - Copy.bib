@article{bryan_2019_the,
	author = {Bryan, Gharad and Morten, Melanie},
	annote = {In their paper, "The Aggregate Productivity Effects of Internal Migration: Evidence from Indonesia" Bryan and Morten estimate the aggregate productivity gains from reducing barriers to internal migration in Indonesia. They build a model where workers have idiosyncratic location-specific productivity and where locations differ in their overall productivity. They then combine this framework with micro-data from Indonesia. The authors estimate a 22\% increase in labor productivity as a result of removing all trade barriers. This is relevant to my own work because I am curious as to how changes in tourism arrivals and the overall size of the tourism industry in Jamaica impact migration decisions, the spatial distribution of the population, and the growth of the economy as a whole. },
