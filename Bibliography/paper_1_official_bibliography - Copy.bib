@article{Lyon2018-nf,
	title    = "Redistributing the gains from trade through progressive taxation",
	author   = "Lyon, Spencer G and Waugh, Michael E",
	abstract = "Should a nation's tax system become more progressive as it opens
	to trade? Does opening to trade change the benefits of a
	progressive tax system? We answer these question within a
	standard incomplete markets model with frictional labor markets
	and Ricardian trade. Consistent with empirical evidence, adverse
	shocks to comparative advantage lead to labor income losses for
	import-competition-exposed workers; with incomplete markets,
	these workers are imperfectly insured and experience welfare
	losses. A progressive tax system is valuable, as it substitutes
	for imperfect insurance and redistributes the gains from trade.
	However, it also reduces the incentives for labor to reallocate
	away from comparatively disadvantaged locations. We find that
	optimal progressivity should increase with openness to trade with
	a ten percentage point increase in openness necessitating a five
	percentage point increase in marginal tax rates for those at the
	top of the income distribution.",
	journal  = "J. Int. Econ.",
	volume   =  115,
	pages    = "185--202",
	month    =  nov,
	year     =  2018,
	keywords = "Trade Literature;Econometrics"
}

@article{McDavid2003-rj,
	title     = "{AN} {INPUT-OUTPUT} {ANALYSIS} {OF} {THE} {JAMAICAN}
	{HOSPITALITY} {AND} {TOURISM} {SECTOR}",
	author    = "McDavid, Hilton",
	abstract  = "[Tourism, today, has emerged not only as the engine of growth
	but has become the largest and the fastest growing sector in the
	Caribbean. For this reason the industry is now viewed as one of
	the leading instruments of development in the region. The paper
	examines the Jamaican Hospitality and Tourism Sector with the
	use of the 1993 Input-output model. The use of this model
	facilitated the focusing on the structural relationships which
	remain hidden when the Hospitality and Tourism Sector is studied
	by itself. The output multiplier for the sector is small and was
	estimated at 1.26904 which is in line with the multiplier for
	the macro-economy. The implication is that \$1.00 spent by the
	Hospitality and Tourism Sector only generates \$1.27 in output
	from the other sectors. Domestic purchases represent 65.35\% of
	total inputs while imports account for 14.76\%. Imports are
	broken down into competitive imports 12.18\% and noncompetitive
	imports 2.58\%. However, this does not include the import
	content of manufactured items, which in many cases are really
	assembled in Jamaica. El turismo, en la actualidad, ha emergido
	no solo como la m{\'a}quina de crecimiento sino que se ha
	convertido en el sector m{\'a}s grande y con m{\'a}s {\'a}pido
	crecimiento en el Caribe. Por esta raz{\'o}n, la industria es
	ahora vista como uno de los instrumentos de desarrollo a la
	vanguardia en la regi{\'o}n. El documento examina la
	Hospitalidad Jamaiquina y al Sector Turismo con el uso del
	modelo de Entrada-salida de 1993. El uso de este modelo
	facilit{\'o} el enfoque en las relaciones estructurales que
	permanecen ocultas cuando el sector de Hospitalidad y Turismo es
	estudiado por aparte. El multiplicador de salida para los
	sectoress es peque{\~n}o y fu{\'e} estimadoen 126904 que
	est{\'a} en l{\'\i}nea con el multiplicador para las
	macroeconom{\'\i}as. La implicaci{\'o}n es que \$1.00 gastado
	por el sector Hospitalidad y Turismo, solo genera \$1.27 en
	salidas de los otros sectores. Las compras dom{\'e}sticas
	representan 65.35\% del total de las entradas, mientras que las
	importaciones representan 14.76\%. Las importaciopnes son
	desglosadas en importaciones competitivas 12.18\% e
	importaciones no competitivas2.58\%. Sim embargo, esto no
	incluye el contenido de las importaciones de art{\'\i}culos
	fabricados, que en muchos casos son raramente ensamblados en
	Jamaica. Le tourisme s'av{\`e}re aujourd'hui {\^e}tre le moteur
	de la croissance mais il est devenu le secteur le plus grand et
	le plus progressif dans la Cara{\"\i}be. Pour cette raison,
	l'industrie est consid{\'e}r{\'e}e comme {\'e}tant l'un des
	premiers instruments du d{\'e}veloppement dans la Cara{\"\i}be.
	Le pr{\'e}sent article examine le Secteur jamaicain du tourisme
	et de l'h{\^o}tellerie, {\`a} l'aide du mod{\`e}le
	d'entr{\'e}esortie de 1993. L'utilisation de ce mod{\`e}le a
	permis un examen plus rigoureux des relations structurales qui
	restent cach{\'e}es lorsqu'on {\'e}tudie le secteur de
	mani{\`e}re isol{\'e}e. Le multiplicateur pour le secteur est
	petit, estim{\'e} {\`a} 1,26904, ce qui est conforme au
	multiplicateur de la micro-{\'e}conomie. Ceci implique que
	chaque dollar d{\'e}pens{\'e} par le secteur de l'h{\^o}tellerie
	et du tourisme ne g{\'e}n{\`e}re que \$1,27 de sortie des autres
	secteurs. Les achats locaux repr{\'e}sentent 65,35\% de la
	totalit{\'e} des entr{\'e}es, alors que les importations n'en
	repr{\'e}sentent que14,76\%. Les importations se d{\'e}composent
	en importations comp{\'e}titives (12,18\%) et importatins non
	comp{\'e}titives 2,58\%. N{\'e}anmoins, ceci ne comprend pas la
	partie import{\'e}e des produits fabriqu{\'e}s en Jama{\"\i}que,
	qui, dans beaucoup de cas, sont tout simplement assembl{\'e}s en
	Jama{\"\i}que.]",
	journal   = "Soc. Econ. Stud.",
	publisher = "University of the West Indies",
	volume    =  52,
	number    =  1,
	pages     = "161--184",
	year      =  2003,
	keywords  = "Tourism;Econometrics"
