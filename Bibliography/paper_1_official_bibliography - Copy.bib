@article{Braithwaite2017-sk,
	title     = "What do demand and supply shocks say about Caribbean monetary
	integration?",
	author    = "Braithwaite, Samuel",
	abstract  = "Abstract This study seeks to ascertain whether the member states
	of the Caribbean Community (CARICOM) share similar supply and
	demand shocks. If so, an argument can be made for the
	suitability of said countries being part of a currency union.
