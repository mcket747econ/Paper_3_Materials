@article{lyon_2018_redistributing,
	author = {Lyon, Spencer G. and Waugh, Michael E.},
	annote = {In this paper, the authors attempt to understand how the optimal progressivity of the tax code should change with openness to trade. They build a small open economy model with mobile labor and calibrate the model to the U.S. economy. They find that the optimal progressivity of the tax code is increasing with trade openness, and that the gains from more progressivity are increasing in a country's openness. This is relevant to my focus as tourism as there is great heterogeneity in the size of tourism industries relative to other sectors of the economies of tourism destination countries. As tourism is a major source of revenue for many countries, it is relevant to understand how the optimal taxing of this sector may change with its size relative to other parts of an economy. Lyon and Waugh (2018) provides a useful framework for approaching this. },
	month = {11},
	pages = {185-202},
	title = {Redistributing the gains from trade through progressive taxation},
	doi = {10.1016/j.jinteco.2018.09.008},
	urldate = {2021-11-06},
	volume = {115},
	year = {2018},
	journal = {Journal of International Economics}
}

@article{heathcote_2017_optimal,
	author = {Heathcote, Jonathan and Storesletten, Kjetil and Violante, Giovanni L.},
	annote = {In this paper thr authors attempt to understand what shapes of the optimal degree of progressivity of the tax and transfer system. To do this they develop an equilibrium model that features the tradeoffs between progressivity reducing the incentives to work and invest in skills while also helping correct inequality. They find that endogenous skill investment, a flexible labor supply, and the goal of financing government purchases all play equal roles in the optimal progressivity of the tax system. This is relevant to my focus on tourism because the tourism sector serves as a major source of revenue for the Jamaican government, as well as the governments of other tourism dependent economies. Understanding how to optimally shape the tax code to best improve the welfare of citizens is of great importance. },
	month = {06},
	pages = {1693-1754},
	title = {Optimal Tax Progressivity: An Analytical Framework*},
	doi = {10.1093/qje/qjx018},
	urldate = {2019-12-25},
	volume = {132},
	year = {2017},
	journal = {The Quarterly Journal of Economics}
}

@article{baln_2022_local,
	author = {Balán, Pablo and Bergeron, Augustin and Tourek, Gabriel and Weigel, Jonathan L.},
	annote = {In this paper the authors attempt to understand the tradeoffs between local elites and government actors as tax collectors in nations with low state capacity. The authors study a randomized policy experiment in which certain neighborhoods of a large city in the Democratic Republic of Congo named Kananga were randomly assigned to have either local elites or government actors as tax collectors. Using local elites raised tax compliance by 3.2 percentage points and revenue by 44\%. This is particularly relevant to my own work as a major development issue for the Jamaican tourism industry is the size of the informal sector. A key question is how to increase formalization and this paper provides useful insights.},
	month = {03},
	pages = {762-797},
	title = {Local Elites as State Capacity: How City Chiefs Use Local Information to Increase Tax Compliance in the Democratic Republic of the Congo},
	doi = {10.1257/aer.20201159},
	urldate = {2022-05-23},
	volume = {112},
	year = {2022},
	journal = {American Economic Review}
}

@article{hausmann_2006_what,
	author = {Hausmann, Ricardo and Hwang, Jason and Rodrik, Dani},
	annote = {In the paper "What You Export Matters" attempt to answer the questions of "Why do countries produce the goods that they do, and does it matter?". In order to do this the authors construct an index that they argue measures the "quality" of countries' export baskets. They find that their index is positively correlated with growth, with their model showing that a 10\% increase in their index is associated with a half a percentage point increase in growth. In studying tourism I am curious if certain types of tourism specialization lead to long run equilibria where a nation is unable to advance or industrialize because of the structural impacts of tourism on other parts  of the economy. This paper provides a framework by which to analyze this potential outcome. },
	month = {12},
	pages = {1-25},
	title = {What you export matters},
	doi = {10.1007/s10887-006-9009-4},
	volume = {12},
	year = {2006},
	journal = {Journal of Economic Growth}
}

@article{dixcarneiro_2021_trade,
	author = {Dix-Carneiro, Rafael and Goldberg, Pinelopi Koujianou and Meghir, Costas and Ulyssea, Gabriel},
	annote = {In the paper "Trade and Informality in the Presence of Labor Market Frictions and Regulations", the authors  analyze the relationship between trade and the size of the informal sector. The authors build an equilibrium model of a small open economy that has labor market frictions, and regulations that are not fully enforced. Using data from Brazil, they find that trade openness decreases informality in the tradable sector, results in large welfare gains even when informality is repressed, and that repressing informality increases productivity but decreases employment and welfare  levels. This is relevant to my focus on tourism because in Jamaica and in other tourism dependent countries, a large share of workers in the tourism industry are in the informal sector. Understanding the impact of trade on welfare in developing economies must take account of the role that the informal sector has to play.},
	title = {Trade and Informality in the Presence of Labor Market Frictions and Regulations},
	doi = {10.2139/ssrn.3822403},
	urldate = {2021-10-28},
	year = {2021},
	journal = {SSRN Electronic Journal}
}

