@article{Amaral2006-rk,
	title    = "A competitive model of the informal sector",
	author   = "Amaral, Pedro S and Quintin, Erwan",
	abstract = "In developing nations, formal workers tend to be more
	experienced, more educated, and earn more than informal workers.
	These facts are often interpreted as evidence that low-skill
	workers face barriers to entry into the formal sector. Yet, there
	is little empirical evidence that such barriers are important.
	This paper describes a model where, in equilibrium, the
	characteristics of formal and informal workers differ
	systematically, even though labor markets are perfectly
	competitive. The informal sector emphasizes low-skill work, as in
	the data, because informal managers have access to less outside
	financing, and choose to substitute low-skill labor for physical
	capital.",
	journal  = "J. Monet. Econ.",
	volume   =  53,
	number   =  7,
	pages    = "1541--1553",
	month    =  oct,
	year     =  2006,
	keywords = "Informal sector; Organization of production; Limited enforcement"
}

