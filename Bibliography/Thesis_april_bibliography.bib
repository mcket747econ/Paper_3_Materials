	author = {Heathcote, Jonathan and Storesletten, Kjetil and Violante, Giovanni L.},
	month = jun,
	year = {2017},
	keywords = {notion},
	pages = {1693--1754},
	annote = {In this paper thr authors attempt to understand what shapes of the optimal degree of progressivity of the tax and transfer system. To do this they develop an equilibrium model that features the tradeoffs between progressivity reducing the incentives to work and invest in skills while also helping correct inequality. They find that endogenous skill investment, a flexible labor supply, and the goal of financing government purchases all play equal roles in the optimal progressivity of the tax system. This is relevant to my focus on tourism because the tourism sector serves as a major source of revenue for the Jamaican government, as well as the governments of other tourism dependent economies. Understanding how to optimally shape the tax code to best improve the welfare of citizens is of great importance. },
	file = {Full Text:C\:\\Users\\mcket\\Zotero\\storage\\E84KF6HE\\Heathcote et al. - 2017 - Optimal Tax Progressivity An Analytical Framework.pdf:application/pdf},
}

