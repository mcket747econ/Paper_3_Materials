	keywords = {notion},
	pages = {w23535},
	file = {McFadden - 2017 - Foundations of Welfare Economics and Product Marke.pdf:C\:\\Users\\mcket\\Zotero\\storage\\M2C3PBSL\\McFadden - 2017 - Foundations of Welfare Economics and Product Marke.pdf:application/pdf},
