@article{lyon_redistributing_2018,
	title = {Redistributing the gains from trade through progressive taxation},
	volume = {115},
	doi = {10.1016/j.jinteco.2018.09.008},
	urldate = {2021-11-06},
	journal = {Journal of International Economics},
	author = {Lyon, Spencer G. and Waugh, Michael E.},
	month = nov,
	year = {2018},
	keywords = {notion, Econometrics, Trade Literature},
	pages = {185--202},
	annote = {In this paper, the authors attempt to understand how the optimal progressivity of the tax code should change with openness to trade. They build a small open economy model with mobile labor and calibrate the model to the U.S. economy. They find that the optimal progressivity of the tax code is increasing with trade openness, and that the gains from more progressivity are increasing in a country's openness. This is relevant to my focus as tourism as there is great heterogeneity in the size of tourism industries relative to other sectors of the economies of tourism destination countries. As tourism is a major source of revenue for many countries, it is relevant to understand how the optimal taxing of this sector may change with its size relative to other parts of an economy. Lyon and Waugh (2018) provides a useful framework for approaching this. },
	file = {Lyon and Waugh - 2018 - Redistributing the gains from trade through progre.pdf:C\:\\Users\\mcket\\Zotero\\storage\\A8WIK49C\\Lyon and Waugh - 2018 - Redistributing the gains from trade through progre.pdf:application/pdf;ScienceDirect Snapshot:C\:\\Users\\mcket\\Zotero\\storage\\QI55V3GR\\S0022199618303672.html:text/html;ScienceDirect Snapshot:C\:\\Users\\mcket\\Zotero\\storage\\ILJMFKMQ\\S0022199618303672.html:text/html},
}

