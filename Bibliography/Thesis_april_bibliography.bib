
@article{pinkham-goldsmith_bartik_nodate,
	title = {Bartik {Instruments}: {What}, {When}, {Why}, and {How}?},
	abstract = {The Bartik instrument is formed by interacting local industry shares and national industry growth rates. We show that the typical use of a Bartik instrument assumes a pooled exposure research design, where the shares measure differential exposure to common shocks, and identification is based on exogeneity of the shares. Next, we show how the Bartik instrument weights each of the exposure designs. Finally, we discuss how to assess the plausibility of the research design. We illustrate our results through three applications: estimating the elasticity of labor supply, estimating local labor market effects of Chinese imports, and estimating the elasticity of substitution between immigrants and natives.},
	journal = {Econometrica},
	author = {Pinkham-Goldsmith},
	keywords = {notion},
	file = {_.pdf:C\:\\Users\\mcket\\Zotero\\storage\\ITNMRMH9\\_.pdf:application/pdf},
}

@article{faber_tourism_2019,
	title = {Tourism and {Economic} {Development}: {Evidence} from {Mexico}’s {Coastline}},
	volume = {109},
	url = {http://economics.mit.edu/files/11206},
	doi = {10.1257/aer.20161434},
	journal = {American Economic Review},
	author = {Faber, Benjamin and Gaubert, Cecile},
	month = jun,
	year = {2019},
	keywords = {notion, Tourism},
	pages = {2245--2293},
	annote = {In their paper "Tourism and Economic Development: Evidence from Mexico's Coastline" Faber and Gaubert study the long-term economic consequences of tourism at the local and national level in Mexico. They make use of microdata on municipality-level hotel revenues, employment, population and wages, along with census and geographic information systems(GIS) data to test a quantitative spatial equilibrium model. They use GIS data to create measures of tourism attractiveness as an independent variable in their empirical analysis. The authors find that tourism causes large and significant long-run local economic gains.They also find that the local impacts are driven by significant positive multiplier effects on manufacturing production. This work relates closely to my own as it analyzes the impact of tourism on the welfare of the citizens of a host-region via the impact of the tourism sector on incomes and other industries. Mexico is also a competitor of Jamaica with a similar product offering, making this study even more relevant to my own. },
	file = {Full Text:C\:\\Users\\mcket\\Zotero\\storage\\DFLDWQSP\\Faber and Gaubert - 2019 - Tourism and Economic Development Evidence from Me.pdf:application/pdf},
}

@article{aragon_natural_2013,
	title = {Natural {Resources} and {Local} {Communities}: {Evidence} from a {Peruvian} {Gold} {Mine}},
	volume = {5},
	doi = {10.1257/pol.5.2.1},
	urldate = {2019-06-12},
	journal = {American Economic Journal: Economic Policy},
	author = {Aragón, Fernando M and Rud, Juan Pablo},
	month = may,
	year = {2013},
	keywords = {notion},
	pages = {1--25},
	annote = {In their paper "Natural Resources and Local Communities: Evidence from a Peruvian Gold Mine" Aragon and Rud investigate the welfare impacts of a major change in policy by the Yanacocha Gold Mine in northern Peru. In the late 1990s, after previously being insulated from the surrounding community, the Yanacocha mine had a change in corporate policy that required the mine to use more local labor and raw material inputs. The authors then conduct a difference-in-difference analysis by exploiting variation in the mine's policy regarding the use of local inputs, as well as variation in distance from the mine. They find that the change in mine's policy is associated with statistically significant increases in real income and household wealth. Tourism can be viewed as a natural resource, and there is variation in the extent to which backward and forward linkages exist between the tourism industry and other sectors of the economy. One goal of my research will be to investigate the relationship between the strength of these linkages and the welfare of local populations.},
	file = {JSTOR Full Text PDF:C\:\\Users\\mcket\\Zotero\\storage\\P924TJJG\\Aragón and Rud - 2013 - Natural Resources and Local Communities Evidence .pdf:application/pdf;Submitted Version:C\:\\Users\\mcket\\Zotero\\storage\\NJ2A4T4F\\Aragón and Rud - 2013 - Natural Resources and Local Communities Evidence .pdf:application/pdf},
}

