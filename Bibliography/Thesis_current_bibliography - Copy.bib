@article{adao_shift-share_2019,
	title = {Shift-{Share} {Designs}: {Theory} and {Inference}},
	volume = {134},
	issn = {0033-5533, 1531-4650},
	shorttitle = {Shift-{Share} {Designs}},
	url = {http://arxiv.org/abs/1806.07928},
	doi = {10.1093/qje/qjz025},
	abstract = {We study inference in shift-share regression designs, such as when a regional outcome is regressed on a weighted average of sectoral shocks, using regional sector shares as weights. We conduct a placebo exercise in which we estimate the effect of a shift-share regressor constructed with randomly generated sectoral shocks on actual labor market outcomes across U.S. Commuting Zones. Tests based on commonly used standard errors with 5{\textbackslash}\% nominal significance level reject the null of no effect in up to 55{\textbackslash}\% of the placebo samples. We use a stylized economic model to show that this overrejection problem arises because regression residuals are correlated across regions with similar sectoral shares, independently of their geographic location. We derive novel inference methods that are valid under arbitrary cross-regional correlation in the regression residuals. We show using popular applications of shift-share designs that our methods may lead to substantially wider confidence intervals in practice.},
	number = {4},
	urldate = {2025-08-19},
	journal = {The Quarterly Journal of Economics},
	author = {Adão, Rodrigo and Kolesár, Michal and Morales, Eduardo},
	month = nov,
	year = {2019},
	note = {arXiv:1806.07928 [econ]},
	keywords = {Economics - Econometrics},
	pages = {1949--2010},
	file = {Full Text PDF:C\:\\Users\\mcket\\Zotero\\storage\\6L3Q6689\\Adão et al. - 2019 - Shift-Share Designs Theory and Inference.pdf:application/pdf;Snapshot:C\:\\Users\\mcket\\Zotero\\storage\\HUKQ2QTG\\1806.html:text/html},
}

