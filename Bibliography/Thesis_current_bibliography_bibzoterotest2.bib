@article{mccullough_structural_2025,
  title = {Structural Transformation without Industrialization? {{Evidence}} from {{Tanzanian}} Consumers.},
  shorttitle = {Structural Transformation without Industrialization?},
  author = {McCullough, Ellen B.},
  date = {2025-03},
  journaltitle = {American Journal of Agricultural Economics},
  shortjournal = {American J Agri Economics},
  volume = {107},
  number = {2},
  pages = {411--439},
  issn = {0002-9092, 1467-8276},
  doi = {10.1111/ajae.12501},
  url = {https://onlinelibrary.wiley.com/doi/10.1111/ajae.12501},
  urldate = {2025-10-22},
  abstract = {Abstract             Export‐oriented industrialization was central to many Asian countries' structural transformation processes, but many African countries are bypassing industrialization, and the prospects for competing in global manufacturing markets are poor. Alternative structural transformation pathways all rely on domestic markets, and thus understanding their trajectories requires uncovering consumer preferences. Using detailed household expenditures data from a nationally representative panel survey in Tanzania, I estimate a flexible, stylized consumer demand system. I recover estimates of expenditure elasticities of demand for goods, services, and food in the aggregate, along with price elasticities of demand, identified using within‐household variation in prices and expenditures. I find that, across the expenditures distribution and in both rural and urban areas, consumer preferences are service facing. In particular, I show that (1) consumers sharply increase spending on services relative to goods and food as incomes increase; (2) demand for services in the aggregate is somewhat sensitive to changes in service prices; and (3) food, goods, and services are substitutes for each other. On one hand, a high propensity to consume the types of services that generate large local economic growth multipliers is consistent with driving growth in service sector employment. However, sustained growth in the long run may be limited because these services are low productivity and nontradable, and domestic markets are size constrained.},
  langid = {english},
  file = {C:\Users\mcket\Zotero\storage\M22DE2KG\McCullough - 2025 - Structural transformation without industrialization Evidence from span style=font-variantsmall-c.pdf}
}

@article{mcdavid_input-output_2003,
  title = {{{AN INPUT-OUTPUT ANALYSIS OF THE JAMAICAN HOSPITALITY AND TOURISM SECTOR}}},
  author = {McDavid, Hilton},
  date = {2003},
  journaltitle = {Soc. Econ. Stud.},
  volume = {52},
  number = {1},
  pages = {161--184},
  publisher = {University of the West Indies},
  abstract = {[Tourism, today, has emerged not only as the engine of growth but has become the largest and the fastest growing sector in the Caribbean. For this reason the industry is now viewed as one of the leading instruments of development in the region. The paper examines the Jamaican Hospitality and Tourism Sector with the use of the 1993 Input-output model. The use of this model facilitated the focusing on the structural relationships which remain hidden when the Hospitality and Tourism Sector is studied by itself. The output multiplier for the sector is small and was estimated at 1.26904 which is in line with the multiplier for the macro-economy. The implication is that \textbackslash 1.00 spent by the Hospitality and Tourism Sector only generates \textbackslash 1.27 in output from the other sectors. Domestic purchases represent 65.35\% of total inputs while imports account for 14.76\%. Imports are broken down into competitive imports 12.18\% and noncompetitive imports 2.58\%. However, this does not include the import content of manufactured items, which in many cases are really assembled in Jamaica. El turismo, en la actualidad, ha emergido no solo como la máquina de crecimiento sino que se ha convertido en el sector más grande y con más ápido crecimiento en el Caribe. Por esta razón, la industria es ahora vista como uno de los instrumentos de desarrollo a la vanguardia en la región. El documento examina la Hospitalidad Jamaiquina y al Sector Turismo con el uso del modelo de Entrada-salida de 1993. El uso de este modelo facilitó el enfoque en las relaciones estructurales que permanecen ocultas cuando el sector de Hospitalidad y Turismo es estudiado por aparte. El multiplicador de salida para los sectoress es pequeño y fué estimadoen 126904 que está en línea con el multiplicador para las macroeconomías. La implicación es que \textbackslash 1.00 gastado por el sector Hospitalidad y Turismo, solo genera \textbackslash 1.27 en salidas de los otros sectores. Las compras domésticas representan 65.35\% del total de las entradas, mientras que las importaciones representan 14.76\%. Las importaciopnes son desglosadas en importaciones competitivas 12.18\% e importaciones no competitivas2.58\%. Sim embargo, esto no incluye el contenido de las importaciones de artículos fabricados, que en muchos casos son raramente ensamblados en Jamaica. Le tourisme s'avère aujourd'hui être le moteur de la croissance mais il est devenu le secteur le plus grand et le plus progressif dans la Caraïbe. Pour cette raison, l'industrie est considérée comme étant l'un des premiers instruments du développement dans la Caraïbe. Le présent article examine le Secteur jamaicain du tourisme et de l'hôtellerie, à l'aide du modèle d'entréesortie de 1993. L'utilisation de ce modèle a permis un examen plus rigoureux des relations structurales qui restent cachées lorsqu'on étudie le secteur de manière isolée. Le multiplicateur pour le secteur est petit, estimé à 1,26904, ce qui est conforme au multiplicateur de la micro-économie. Ceci implique que chaque dollar dépensé par le secteur de l'hôtellerie et du tourisme ne génère que \$1,27 de sortie des autres secteurs. Les achats locaux représentent 65,35\% de la totalité des entrées, alors que les importations n'en représentent que14,76\%. Les importations se décomposent en importations compétitives (12,18\%) et importatins non compétitives 2,58\%. Néanmoins, ceci ne comprend pas la partie importée des produits fabriqués en Jamaïque, qui, dans beaucoup de cas, sont tout simplement assemblés en Jamaïque.]},
  keywords = {Econometrics,notion,Tourism},
  file = {C:\Users\mcket\Zotero\storage\AED82KXQ\McDavid - 2003 - An Input-Output Analysis of the Jamaican Hospitali.pdf}
}

@report{mcfadden_foundations_2017,
  title = {Foundations of {{Welfare Economics}} and {{Product Market Applications}}},
  author = {McFadden, Daniel},
  date = {2017-06},
  number = {w23535},
  pages = {w23535},
  institution = {National Bureau of Economic Research},
  location = {Cambridge, MA},
  doi = {10.3386/w23535},
  url = {http://www.nber.org/papers/w23535.pdf},
  urldate = {2024-04-09},
  abstract = {A common problem in applied economics is to determine the impact on consumers of changes in prices and attributes of marketed products as a consequence of policy changes. Examples are prospective regulation of product safety and reliability, or retrospective compensation for harm from defective products or misrepresentation of product features. This paper reexamines the foundations of welfare analysis for these applications. We consider discrete product choice, and develop practical formulas that apply when discrete product demands are characterized by mixed multinomial logit models and policy changes affect hedonic attributes of products in addition to price. We show that for applications that are retrospective, or are prospective but compensating transfers are hypothetical rather than fulfilled, a Market Compensating Equivalent measure that updates Marshallian consumer surplus is more appropriate than Hicksian compensating or equivalent variations. We identify the welfare questions that can be answered in the presence of partial observability on the preferences of individual consumers. We examine the welfare calculus when the experienced-utility of consumers differs from the decision-utility that determines market demands, as the result of resolution of contingencies regarding attributes of products and interactions with consumer needs, or as the result of inconsistencies in tastes and incomplete optimizing behavior. We conclude with an illustrative application that calculates the welfare impacts of unauthorized sharing of consumer information by video streaming services.},
  langid = {english},
  keywords = {notion},
  file = {C:\Users\mcket\Zotero\storage\M2C3PBSL\McFadden - 2017 - Foundations of Welfare Economics and Product Marke.pdf}
}

