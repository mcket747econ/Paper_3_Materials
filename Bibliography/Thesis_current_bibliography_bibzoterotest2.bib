@article{xie_go_2023,
  title = {Go with the Wind: {{Spatial}} Impacts of Environmental Regulations on Economic Activities in {{China}}},
  author = {Xie, Tingting and Yuan, Ye},
  date = {2023-06-23},
  journaltitle = {J. Dev. Econ.},
